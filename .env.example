# Required — server will refuse to start without this
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional (defaults shown)
# JWT_EXPIRES_IN=30m                 # Access token lifetime
# JWT_REFRESH_EXPIRES_IN=7d          # Refresh token lifetime
# CORS_ORIGIN=                       # Comma-separated allowed origins (e.g. https://example.com,https://other.com)
# NWS_USER_AGENT=                    # Required by NWS API for weather — format: (AppName, contact@email.com)
# HOST_PORT=80                       # Port exposed by Docker nginx container
# DATABASE_URL=file:./dev.db         # Prisma SQLite database path
# UPLOADS_DIR=./uploads              # Directory for uploaded files
# VITE_API_URL=                      # Admin frontend API base URL (empty = same-origin, used at build time)
